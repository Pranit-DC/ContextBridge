# Copy to .env and replace both placeholders. Never commit .env.
CONTEXTBRIDGE_API_TOKEN=replace-with-a-random-token-at-least-32-characters
CONTEXTBRIDGE_DB_PASSWORD=replace-with-a-random-local-database-password
# Host port for the Compose database; keep the URL below in sync if changing it.
CONTEXTBRIDGE_DB_PORT=5433
CONTEXTBRIDGE_DATABASE_URL=postgresql+psycopg://contextbridge:replace-with-a-random-local-database-password@127.0.0.1:5433/contextbridge
CONTEXTBRIDGE_DEVELOPER_ID=local-developer
# Optional P1 durable ingestion: explicitly bind this API instance to one project.
# CONTEXTBRIDGE_CAPTURE_PROJECT_ID=contextbridge
CONTEXTBRIDGE_CAPTURE_ALLOW_DEVELOPER=false
# Optional grouping of explicitly imported turns; this installs no capture hook.
CONTEXTBRIDGE_CAPTURE_GROUPING_ENABLED=false
CONTEXTBRIDGE_CAPTURE_GROUP_IDLE_SECONDS=30
CONTEXTBRIDGE_CAPTURE_GROUP_MAX_EVENTS=5
CONTEXTBRIDGE_CAPTURE_GROUP_MAX_MESSAGES=20
CONTEXTBRIDGE_CAPTURE_GROUP_MAX_CHARACTERS=32000
# Source timezone for imports, never an assumed worker/importing-machine timezone.
# CONTEXTBRIDGE_CAPTURE_SOURCE_TIMEZONE=Asia/Kolkata
CONTEXTBRIDGE_CAPTURE_RETENTION_SECONDS=86400
CONTEXTBRIDGE_CAPTURE_MAX_BUFFERED_EVENTS=1000
CONTEXTBRIDGE_CANDIDATE_RETENTION_SECONDS=3600

# Optional P4 Linux-container workers on Linux and Windows Docker Desktop.
# Set a reviewed local provider factory returning WorkerProviders, then enable --profile workers.
# CONTEXTBRIDGE_WORKER_FACTORY=your_package.worker:make
CONTEXTBRIDGE_WORKER_MAX_ATTEMPTS=3
CONTEXTBRIDGE_WORKER_TIMEOUT_SECONDS=120
CONTEXTBRIDGE_WORKER_RETRY_SECONDS=10
CONTEXTBRIDGE_WORKER_DIAGNOSTIC_RETENTION_SECONDS=604800

# Optional P5: reviewed factory returning IntegrationBackends for BOTH API and worker.
# Choose integration_factory OR legacy worker_factory, never both. No provider is selected here.
# CONTEXTBRIDGE_INTEGRATION_FACTORY=your_package.providers:make
# CONTEXTBRIDGE_EMBEDDING_MODEL_ID=team-approved-model-id
# CONTEXTBRIDGE_EMBEDDING_DIMENSIONS=384
CONTEXTBRIDGE_PROVIDER_TIMEOUT_SECONDS=10

# Optional hosted embeddings: API + indexing workers, no local model or custom factory needed.
# CONTEXTBRIDGE_EMBEDDING_PROVIDER=cloudflare
# CONTEXTBRIDGE_EMBEDDING_API_KEY=replace-with-your-workers-ai-token
# CONTEXTBRIDGE_EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
# CONTEXTBRIDGE_EMBEDDING_MODEL_ID=@cf/qwen/qwen3-embedding-0.6b
# This specific Cloudflare model defaults to 1024; other dimensions are rejected.
# Bind CONTEXTBRIDGE_CAPTURE_PROJECT_ID above and enable --profile workers to index that project.
# See docs/cloudflare-embeddings.md for boundaries, limits, and a synthetic live probe.

# Built-in V1 processing is opt-in; credentials alone never enable processing.
CONTEXTBRIDGE_FORMATION_ENABLED=false
# One compatible current-memory consolidation batch every 15 minutes; opt in explicitly.
CONTEXTBRIDGE_CONSOLIDATION_ENABLED=false
# CONTEXTBRIDGE_FORMATION_PROVIDER=openai-compatible
# CONTEXTBRIDGE_FORMATION_BASE_URL=https://api.groq.com/openai/v1
# CONTEXTBRIDGE_FORMATION_MODEL=openai/gpt-oss-120b
# CONTEXTBRIDGE_FORMATION_API_KEY=replace-with-your-groq-token
# CONTEXTBRIDGE_FORMATION_ALLOW_HOSTED=true
CONTEXTBRIDGE_FORMATION_ALLOW_PAID=false
# Confirm your account is Free before enabling; this is an operator attestation.
# CONTEXTBRIDGE_FORMATION_GROQ_FREE_PLAN_CONFIRMED=true
CONTEXTBRIDGE_FORMATION_TOKENS_PER_MINUTE=8000
CONTEXTBRIDGE_FORMATION_TOKENS_PER_DAY=50000
